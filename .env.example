# Application
NEXT_PUBLIC_APP_URL=
# Root domain that store subdomains hang off, e.g. storehub.rw (prod) or localhost:3000 (dev)
NEXT_PUBLIC_ROOT_DOMAIN=
DATABASE_URL=
DIRECT_URL=

# Supabase (optional for now: auth runs on the built-in session layer,
# images use local storage until these are set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MTN MOMO - KEEP BLANK UNTIL CREDENTIALS ARE PROVIDED
MTN_MOMO_BASE_URL=
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=

# Payment configuration
MTN_MOMO_TARGET_ENVIRONMENT=
MTN_MOMO_CURRENCY=RWF
# Dev only: when MTN credentials are blank, lets you approve/decline payments by hand.
# Ignored when NODE_ENV=production.
MOMO_DEV_SIMULATOR=false

# Security
APP_ENCRYPTION_KEY=
AUTH_SECRET=
# Protects /api/cron/* (payment status sweeps)
CRON_SECRET=

# Seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
